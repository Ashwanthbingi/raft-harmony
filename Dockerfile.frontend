# Dockerfile.frontend - TanStack Start frontend (node-server preset)
# Multi-stage build: compile with Node + bun, run with minimal alpine runtime

# ============================================================================
# Stage 1: Build Stage
# ============================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package.json package-lock.json bun.lock* ./

# Install dependencies with npm (or bun if available)
# Using npm since package-lock.json is present and ensures reproducible builds
RUN npm ci --legacy-peer-deps

# Copy source code
COPY src ./src
COPY public ./public
COPY . ./

# Build the frontend with Nitro node-server preset
# This generates .output/server/ with index.mjs entry point
RUN npm run build

# ============================================================================
# Stage 2: Runtime Stage
# ============================================================================
FROM node:20-alpine

WORKDIR /app

# Install dumb-init for proper signal handling in containers
RUN apk add --no-cache dumb-init

# Copy only the built artifacts from the builder stage
# .output/ contains the compiled Nitro server and all necessary files
COPY --from=builder /app/.output ./

# Set environment variables for the Node server
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000

# Expose the port the Nitro node-server runs on
EXPOSE 3000

# Use dumb-init to handle signals properly (PID 1 issue in containers)
ENTRYPOINT ["dumb-init", "--"]

# Start the Nitro server
# .output/server/index.mjs is the entry point generated by node-server preset
CMD ["node", ".output/server/index.mjs"]
